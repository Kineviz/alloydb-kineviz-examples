# Copy to .env; never commit credentials. Same settings for psql and Python.
PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=kineviz_demo
PGUSER=postgres
PGPASSWORD=
# disable ONLY on the loopback leg to Auth Proxy or the local demo container.
# For a direct remote connection use verify-full and PGSSLROOTCERT instead.
PGSSLMODE=disable
PGCONNECT_TIMEOUT=10
# Set a strong local-only admin password before docker compose up.
POSTGRES_PASSWORD=
